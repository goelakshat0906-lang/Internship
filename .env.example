DATABASE_URL="file:./dev.db"

# Optional: live AI. Without either key below, VoltScout uses deterministic
# fallbacks so every feature still works out of the box.
#
# If BOTH keys are set, Anthropic is used by default. Set AI_PROVIDER=gemini
# to force Gemini instead (useful if you want to compare the two).

# Anthropic (Claude) — get a key at https://console.anthropic.com/settings/keys
# Powers the scouting agent (Claude web search), resume matcher, and cover
# letter studio via structured outputs.
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-opus-5) — e.g. claude-haiku-4-5
# for lower cost. Only change this if you explicitly want a different model.
ANTHROPIC_MODEL=

# Google (Gemini) — get a key at https://aistudio.google.com/apikey
# Powers the same three features via Gemini + Google Search grounding.
GEMINI_API_KEY=

# Optional: force a specific provider when both keys are set ("anthropic" | "gemini").
AI_PROVIDER=
